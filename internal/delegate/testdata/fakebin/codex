#!/bin/sh
# Fake codex: the prompt is the last argument.
for a; do prompt="$a"; done
[ -n "$DELEGATE_ARGSOUT" ] && printf '%s\n' "$@" > "$DELEGATE_ARGSOUT"
case "$prompt" in
ok)
  echo '{"type":"thread.started","thread_id":"t"}'
  echo '{"type":"item.completed","item":{"id":"i0","type":"error","message":"deprecated key"}}'
  echo '{"type":"turn.started"}'
  echo '{"type":"item.started","item":{"id":"i1","type":"command_execution","command":"ls"}}'
  echo '{"type":"item.completed","item":{"id":"i2","type":"agent_message","text":"pong from codex"}}'
  echo '{"type":"turn.completed","usage":{"input_tokens":50,"cached_input_tokens":0,"output_tokens":9}}'
  ;;
failed)
  echo '{"type":"turn.failed","error":{"message":"quota exceeded"}}'
  exit 1
  ;;
esac
