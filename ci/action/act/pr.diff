@@ -0,0 +1,18 @@
+package server
+
+import (
+	"net/http"
+	"os"
+	"path/filepath"
+)
+
+// Download serves a file from the uploads directory.
+func Download(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("name")
+	data, err := os.ReadFile(filepath.Join("uploads", name))
+	if err != nil {
+		http.Error(w, err.Error(), 500)
+		return
+	}
+	w.Write(data)
+}
